# Python / Environment variables
.env
.venv/
env/
venv/
__pycache__/
*.pyc
*.pyo

# IDE / AntiGravity
.gemini/
.vscode/
.idea/

# Charts & Uploads temporary files
static/charts/*.png
static/charts/*.svg
static/uploads/*
!static/uploads/.gitkeep

# User-uploaded profile pictures - real user data, not application assets
static/images/profiles/*
!static/images/profiles/.gitkeep
exports/*.csv
exports/*.xlsx
exports/*.pdf

# Logs & Database runtime files
logs/*.log
*.log
database/*.db
database/*.db-journal
scratch/

# Automated DB backups (utils/db_backup.py) - real production data, never source control
db_backups/
backups/
*.bak

