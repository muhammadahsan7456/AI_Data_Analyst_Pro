# ==============================================================================
# AI Data Analyst Pro - Environment Variables
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# ==============================================================================

# --- Session security ---
# A strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one-time key is generated at startup - fine for a quick local
# test, but every restart invalidates all sessions, and this must never be left unset
# in production (predictable/rotating secret keys defeat session security).
SECRET_KEY=

# Set to "true" only once the app is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy). Forces the session cookie to HTTPS-only. Leave unset/false for local
# HTTP development - setting it too early silently breaks login by preventing the
# browser from ever sending the cookie back over plain HTTP.
FORCE_SECURE_COOKIES=false

# --- Database (Microsoft SQL Server via pyodbc) ---
DB_SERVER=
DB_NAME=
# e.g. "ODBC Driver 17 for SQL Server" - must match a driver actually installed on
# the host (see Dockerfile for the apt-get install of msodbcsql17).
DB_DRIVER=ODBC Driver 17 for SQL Server
# "yes" to use Windows Integrated Authentication (local dev only) instead of a
# SQL login - if "yes", DB_USER/DB_PASSWORD are ignored.
DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=
# Optional, local development only: falls back to a local SQLite database if SQL
# Server is unreachable. Must stay unset/false in production - a real DB outage
# should raise a real error, not silently swap to a throwaway local database.
ALLOW_SQLITE_FALLBACK=false

# --- AI question answering (OpenAI SDK against OpenRouter) ---
OPENROUTER_API_KEY=

# --- Outgoing email (OTP codes, password reset, payment/notification emails) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Field-level encryption ---
# Fernet key for encrypting sensitive dataset columns at rest, e.g.:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASET_ENCRYPTION_KEY=

# --- Server ---
# Port the app listens on (both run.py and wsgi.py read this).
PORT=5000
# Max upload size in megabytes enforced by the multi-format file ingestion pipeline.
MAX_UPLOAD_MB=500

# --- Optional limits / maintenance ---
# Daily Ask-AI query cap per user, if enforced by the plan tier.
MAX_AI_QUERIES_PER_DAY=
# How many days of local DB backups utils/db_backup.py keeps before pruning.
DB_BACKUP_RETENTION_DAYS=7
# Directory local DB backups are written to.
DB_BACKUP_DIR=backups
