# Environment Variables for AI Data Analyst Pro

# OpenRouter AI API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Connection (Microsoft SQL Server)
DB_SERVER=DESKTOP-1C016AT
DB_NAME=AI_Data_Analyst_Pro
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes

# Gmail SMTP Email Service Configuration
# Put your real Gmail address and 16-character Google App Password below:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
