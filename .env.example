# ==============================================================================
# AI Data Analyst Pro - environment variables
# Copy to ".env" next to run.py and fill in real values. Never commit the real ".env".
# Every variable the code reads is listed here (checked with a grep of os.getenv /
# os.environ.get across the repo, R-Phase 8). Empty = not set.
# ==============================================================================

# --- Session / runtime ---
# REQUIRED. One stable random value shared by every app process; the app refuses to start
# without it. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# "true" once the site is served over HTTPS (Nginx + TLS): Secure session cookie + HSTS.
# Leave false for plain-HTTP local runs, or login cookies are never sent back.
FORCE_SECURE_COOKIES=false
# "production" marks a production run (used for the loud PUBLIC_BASE_URL startup check).
# FORCE_SECURE_COOKIES=true also counts as production. FLASK_ENV is read as a fallback.
APP_ENV=
FLASK_ENV=

# --- Public URLs ---
# Public origin used in every emailed link (OTP, verification, password reset, reports,
# newsletter unsubscribe), the sitemap/canonical tags and the Google redirect URI.
# Production: https://aidataanalystpro.co.uk  (no trailing slash). Must not be localhost.
PUBLIC_BASE_URL=
# Number of reverse proxies in front of the app whose X-Forwarded-* headers may be trusted
# (Werkzeug ProxyFix). Leave empty when running wsgi.py behind Nginx on the same VM:
# Waitress already trusts that one loopback hop. Set 1 for other servers behind one proxy.
TRUSTED_PROXY_COUNT=
# Support address shown in the footer, contact/privacy pages, emails, invoices, receipts.
# Empty = the default in site_config.py (DEFAULT_SUPPORT_EMAIL).
SUPPORT_EMAIL=

# --- Server ---
# Port the app listens on (run.py and wsgi.py).
PORT=5000
# Interface wsgi.py binds to. Default 127.0.0.1 on a VM (behind Nginx), 0.0.0.0 in Docker.
BIND_HOST=

# --- Database (Microsoft SQL Server via pyodbc) ---
# Host[,port] of SQL Server, e.g. 127.0.0.1,1433 when it runs on the same VM.
DB_SERVER=
DB_NAME=
# ODBC driver installed on the host, e.g. "ODBC Driver 17 for SQL Server".
DB_DRIVER=ODBC Driver 17 for SQL Server
# "yes" = Windows Integrated Authentication (local Windows dev only); then DB_USER/DB_PASSWORD are ignored.
DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=
# Local development/QA only: use a local SQLite file when SQL Server is unreachable.
# Must stay false in production.
ALLOW_SQLITE_FALLBACK=false
# Local DB backups made by utils/db_backup.py: directory and days kept.
DB_BACKUP_DIR=backups
DB_BACKUP_RETENTION_DAYS=7

# --- Encrypted dataset storage ---
# REQUIRED. Master key that wraps each dataset's own AES-256-GCM key (utils/dataset_vault.py).
# Uploads are refused while it is missing. Generate ONCE:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up offline, separately from the database. Losing or changing it makes every
# stored dataset unreadable.
DATASET_ENCRYPTION_KEY=
# "on" stores new datasets encrypted (default). Do not turn off in production.
DATASET_VAULT=on
# Decrypted copies live only in server memory: seconds kept / total rows cached.
DATASET_VAULT_CACHE_TTL_SECONDS=900
DATASET_VAULT_CACHE_MAX_ROWS=3000000

# --- Uploads ---
# Largest accepted upload in MB.
MAX_UPLOAD_MB=500
# Files at or above this size (MB) are processed as a background job with progress polling;
# smaller files are processed synchronously and answered in the same request. Default 50.
UPLOAD_ASYNC_THRESHOLD_MB=50

# --- AI question answering (OpenAI SDK against OpenRouter) ---
OPENROUTER_API_KEY=
# Optional daily Ask AI cap per user.
MAX_AI_QUERIES_PER_DAY=

# --- Outgoing email (OTP, verification, password reset, payment notices) ---
# Each pair is an alias; set one of each: SMTP_SERVER/SMTP_HOST, SMTP_USER/SMTP_USERNAME,
# SMTP_FROM_EMAIL/MAIL_FROM. The From address must be a sender verified with the provider.
SMTP_SERVER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
MAIL_FROM=
# Sender display name (default "AI Data Analyst Pro").
MAIL_FROM_NAME=AI Data Analyst Pro

# --- Google sign-in (Continue with Google) ---
# OAuth 2.0 Client ID of type "Web application" (Google Cloud Console > APIs & Services >
# Credentials). Both are required; without them the button shows a friendly
# "not available" message.
#   Authorized JavaScript origin: https://aidataanalystpro.co.uk
#   Authorized redirect URI:      https://aidataanalystpro.co.uk/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Overrides the redirect URI (default: PUBLIC_BASE_URL + /auth/google/callback).
# Must match the Console entry character for character.
GOOGLE_REDIRECT_URI=

# --- Monetisation (optional) ---
# Google AdSense publisher ID (ca-pub-...). Empty = no ad script is emitted.
ADSENSE_CLIENT_ID=

# --- Selenium test suite only (tests/conftest.py), not read by the app ---
# Server the Selenium tests target (default http://127.0.0.1:5000) and headless switch.
TEST_BASE_URL=
HEADLESS=true
